{
  "name": "uetuluk-portfolio",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --project worker",
    "test:frontend": "vitest run --project frontend",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:report": "playwright show-report",
    "test:prompts": "npm run test:prompts:categorization && npm run test:prompts:layout",
    "test:prompts:categorization": "tsx --tsconfig promptfoo/tsconfig.eval.json promptfoo/eval/categorization-eval.ts",
    "test:prompts:layout": "tsx --tsconfig promptfoo/tsconfig.eval.json promptfoo/eval/layout-eval.ts",
    "test:prompts:view": "promptfoo view",
    "typecheck:promptfoo": "tsc -P promptfoo/tsconfig.eval.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "sync-assets": "for f in public/assets/*.png; do wrangler r2 object put portfolio-assets/assets/$(basename $f) --file=$f; done && wrangler r2 object put portfolio-assets/favicon.ico --file=public/favicon.ico",
    "deploy": "npm run build && npm run sync-assets && wrangler deploy"
  },
  "dependencies": {
    "@unhead/react": "^3.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-responsive-masonry": "^2.9.0",
    "react-router-dom": "^7.18.4",
    "react-spinners": "^0.17.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "unhead": "^3.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-responsive-masonry": "^2.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "promptfoo": "^0.123.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
